# /etc/caddy/Caddyfile on the L&T Katapult VM.
#
# This file is committed to the repo so the config is reviewable in git;
# the live copy lives at /etc/caddy/Caddyfile on the VM. To deploy a change:
#   scp conf/caddy/Caddyfile root@<vm>:/etc/caddy/Caddyfile
#   ssh root@<vm> 'caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy'
#
# The maintenance page at /var/www/lat-maintenance/maintenance.html is
# served whenever an upstream returns 502/503/504 (i.e. lat-nuxt or
# lat-api is rebuilding, down, or unreachable).

{
        email geeks@ilovefreegle.org
}

# Both hostnames share one config: the Katapult hostname (kept as a stable
# fallback) and the public beta subdomain new.lendandtend.com. The A record for
# new.lendandtend.com must resolve to this VM BEFORE reloading Caddy, or the
# Let's Encrypt cert issuance for it will fail (and retry) on every reload.
lat.lend-and-tend.katapult.cloud, new.lendandtend.com {
        encode zstd gzip

        # NO site-wide basic auth. HTTP Basic auth is fundamentally incompatible
        # with this app: the app authenticates every /apiv2 call with its own
        # `Authorization: <jwt>` header, and Safari/WebKit, once a Basic credential
        # is cached for the origin, REPLACES that JWT with `Authorization: Basic …`
        # on same-origin requests — so the API 401s every call and the SPA breaks
        # (blank/grey map, lost session, client crashes). Chromium happened to
        # preserve the JWT, which masked it. Confirmed 2026-06-22.
        #
        # Crawl protection is via X-Robots-Tag (below); Mailpit is the only thing
        # that genuinely needs hiding, so basic auth lives ONLY on /mail (testers
        # never visit it, so the origin is never poisoned for them).
        header X-Robots-Tag "noindex, nofollow"

        # Nuxt server API routes (contact form, Stripe) run in lat-nuxt, NOT the
        # Go API. Caddy uses the first matching handle, so match these BEFORE the
        # /api* -> Go rule below; otherwise Caddy hands /api/contact to Go -> 404.
        @nuxtapi path /api/contact /api/checkout /api/stripe-webhook
        handle @nuxtapi {
                reverse_proxy 127.0.0.1:4002
        }

        # Go API (Freegle apiv2) — handles /apiv2/* and /api/*
        @api path /apiv2* /api*
        handle @api {
                reverse_proxy 127.0.0.1:4001
        }

        # Moderator interface
        handle /admin* {
                reverse_proxy 127.0.0.1:4003
        }

        # Mailpit web UI — behind basic auth (lendandtend / beta) since it's the
        # one thing that must not be public. Safe here because Mailpit uses no
        # `Authorization`-header app auth of its own, and testers never hit /mail
        # (so the Safari JWT-clobber above can't be triggered by normal use).
        # Mailpit serves under /mail via MP_WEBROOT (set in the VM prod override).
        handle /mail* {
                basicauth {
                        lendandtend $2a$14$5I8UjUyWbWYLhBwHVfGIt.X4Lmd5HH1zAk9GIdRHoe1VS6gSxBZIS
                }
                reverse_proxy 127.0.0.1:4025
        }


        # Prefix-routed reverse proxies for the L&T image plumbing.
        # /lat-uploads/<id>   -> lat-tusd (host 127.0.0.1:14080) at /<id>
        # /lat-delivery/...   -> lat-delivery (host 127.0.0.1:14081) at /
        # We use prefix-on-443 instead of separate ports because some mobile
        # carriers and Wi-Fi networks block non-standard outbound ports.
        handle_path /lat-uploads/* {
                reverse_proxy 127.0.0.1:14080
        }
        handle_path /lat-delivery/* {
                reverse_proxy 127.0.0.1:14081
        }

        # Maintenance-page static assets — served directly by Caddy from
        # /var/www/lat-maintenance/. Sits BEFORE the catch-all handle so
        # /maintenance-asset/* never gets proxied to lat-nuxt. That means
        # the maintenance.html can <img src="/maintenance-asset/logo.png">
        # and still resolve when lat-nuxt is the upstream that's down.
        handle_path /maintenance-asset/* {
                root * /var/www/lat-maintenance
                file_server
        }

        # Everything else -> Nuxt SSR frontend
        handle {
                reverse_proxy 127.0.0.1:4002
        }

        # Maintenance page when any upstream is rebuilding/unreachable.
        # Caddy's handle_errors catches reverse_proxy failures (502/503/504)
        # and serves the static maintenance.html instead of Caddy's default
        # bare "502 Bad Gateway" body. The HTML references its own logo via
        # /maintenance-asset/logo.png (above), which Caddy serves directly
        # — so the page renders fully even when lat-nuxt is down.
        handle_errors {
                @upstream_down `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
                handle @upstream_down {
                        root * /var/www/lat-maintenance
                        rewrite * /maintenance.html
                        header Cache-Control "no-store"
                        header Content-Type "text/html; charset=utf-8"
                        file_server
                }
        }

        # Reasonable logging — drop to file so we can grep on issues.
        log {
                output file /var/log/caddy/lat-access.log {
                        roll_size 50mb
                        roll_keep 5
                }
                format console
        }
}
