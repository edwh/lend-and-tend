# Multi-stage Dockerfile for Lend & Tend
# Stage 1: Build Go API
# Stage 2: Runtime with minimal footprint

# Stage 1: Build Go API
FROM golang:1.23-alpine AS builder

WORKDIR /src

# Copy Go API source
COPY iznik-server-go/ .

# Build the binary
RUN CGO_ENABLED=0 go build -o /app/server ./main.go

# Stage 2: Runtime
FROM alpine:3.19

# Install runtime dependencies (certificates for HTTPS, timezone data)
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/server .

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=2s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/apiv2/lat/health || exit 1

# Run the server
CMD ["./server"]
