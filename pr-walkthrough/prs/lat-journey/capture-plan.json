    },
    {
      "name": "timeline.png",
      "route": "/agreement/${GARDEN2_ID}?userId=${LENDER2_ID}",
      "auth": ".auth-tender2.json",
      "clip": ".next-steps",
      "steps": [
        {
          "waitFor": ".lat-timeline"
        },
        {
          "waitMs": 800
        }
      ]
    },
    {
      "name": "checkin.png",
      "route": "/checkin/${GARDEN2_ID}",
