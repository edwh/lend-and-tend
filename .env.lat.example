# Lend & Tend Local Development Environment Variables

# API Configuration
IZNIK_API_V2=http://localhost:8192/apiv2
DATABASE_TYPE=sqlite
SQLITE_PATH=/data/lendandtend.db

# Server Configuration
PORT=8192

# Security - Change in production!
LAT_BLUR_SECRET=change-me-in-production
BASIC_AUTH=

# Stripe Configuration (optional for local dev)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=lat
COMPOSE_FILE=docker-compose.lat.yml
PORT_LAT_API=8192
PORT_LAT_NUXT=3000

# Node Environment
NODE_ENV=development
