COMPOSE_PROJECT_NAME=lat
PORT_LAT_API=8192
PORT_LAT_NUXT=4002
LAT_BLUR_SECRET=dev-secret-change-in-production

# Status container (runs the test suites via HTTP API). Host port → :3000.
# 8082 by default so it doesn't clash with a Freegle status container on 8081.
PORT_LAT_STATUS=8082

# Mail delivery (batch-worker). Dev defaults to the lat-mailpit catcher with no
# auth. For production, send via Mailgun SMTP — which, unlike Freegle's own
# smart host, REQUIRES authentication. Uncomment and fill in on the deploy host:
# LAT_MAIL_HOST=smtp.eu.mailgun.org
# LAT_MAIL_PORT=587
# LAT_MAIL_USERNAME=postmaster@mg.lendandtend.com
# LAT_MAIL_PASSWORD=your-mailgun-smtp-password
# LAT_MAIL_SCHEME=smtp          # STARTTLS on 587; use 'smtps' for port 465
# LAT_MAIL_FROM_ADDRESS=noreply@lendandtend.com
