# Multi-stage build for Lend & Tend Nuxt 3 frontend
# Stage 1: Builder
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
COPY package*.json ./
COPY ./lat/package*.json ./lat/

# `--ignore-scripts` skips the package.json `prepare` hook which tries to
# install git hooks (./setup-hooks.sh) — fails in a Docker context with no
# /.git directory. The Nuxt build itself doesn't need git hooks.
RUN npm ci --ignore-scripts

# Copy source code (both upstream and lat layer)
COPY . .

# Build the application
# The lat/ layer extends the parent Nuxt config via extends: ['../']
RUN npm run build

# Stage 2: Runner
FROM node:20-alpine AS runner

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Set production environment
ENV NODE_ENV=production

# `node:20-alpine` already ships a `node` user (uid 1000). Use it directly
# rather than creating a duplicate uid which fails.
COPY --from=builder --chown=node:node /app/.output .

USER node

# Expose port (matches fly.toml internal_port: 3000)
EXPOSE 3000

# Use dumb-init to ensure signals are properly forwarded to Node process
ENTRYPOINT ["dumb-init", "--"]

# Start the server
CMD ["node", "server/index.mjs"]
