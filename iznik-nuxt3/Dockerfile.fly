# Multi-stage build for Lend & Tend Nuxt 3 frontend
# Stage 1: Builder
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
COPY package*.json ./
COPY ./lat/package*.json ./lat/
RUN npm ci

# Copy source code (both upstream and lat layer)
COPY . .

# Build the application
# The lat/ layer extends the parent Nuxt config via extends: ['../']
RUN npm run build

# Stage 2: Runner
FROM node:20-alpine AS runner

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Set production environment
ENV NODE_ENV=production

# Create non-root user (mirrors the Go API Dockerfile pattern) so the
# Node SSR server doesn't run as root in production.
RUN addgroup -g 1000 nodeuser && adduser -D -u 1000 -G nodeuser nodeuser

# Copy built application from builder stage with non-root ownership
COPY --from=builder --chown=nodeuser:nodeuser /app/.output .

USER nodeuser

# Expose port (matches fly.toml internal_port: 3000)
EXPOSE 3000

# Use dumb-init to ensure signals are properly forwarded to Node process
ENTRYPOINT ["dumb-init", "--"]

# Start the server
CMD ["node", "server/index.mjs"]
